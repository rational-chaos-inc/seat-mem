{
  "name": "rci/member-engagement",
  "description": "SeAT Member Engagement Module - Track corporation member activity across mining, PvP, and tax contributions",
  "type": "seat-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Matta",
      "email": "mattallum1974@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0|^11.0",
    "eveseat/services": "^5.1"
  },
  "autoload": {
    "psr-4": {
      "RCI\\MemberEngagement\\": "src/",
      "RCI\\MemberEngagement\\Database\\": "database/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RCI\\MemberEngagement\\MemberEngagementServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
